# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit real credentials.

MONGODB_URI=mongodb://<user>:<password>@ocean.f4.htw-berlin.de:27017
DB_NAME=berlin-infra
PORT=3000

# Comma separated list of origins allowed to call the API during dev
# (only needed while frontend runs on Vite's dev server, e.g. localhost:5173)
CORS_ORIGIN=http://localhost:5173
